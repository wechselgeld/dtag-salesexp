    "next": "16.1.6",
    "ogl": "^1.0.11",
    "p-retry": "^7.1.1",
    "pg": "^8.20.0",
    "picocolors": "^1.1.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "resend": "^6.9.3",
    "tailwind-merge": "^3.4.1",
    "ws": "^8.20.0",
