{
  "name": "temp_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && next build && cp -r public .next/standalone/ && mkdir -p .next/standalone/.next && cp -r .next/static .next/standalone/.next/",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "manage-admins": "tsx scripts/manage-admins.ts",
    "postinstall": "prisma generate",
    "db:push:dev": "dotenv -e .env.development -- prisma db push",
    "db:push:staging": "dotenv -e .env.staging -- prisma db push",
    "db:push:prod": "dotenv -e .env.production -- prisma db push",
    "db:migrate:dev": "dotenv -e .env.development -- prisma migrate dev",
    "db:migrate:staging": "dotenv -e .env.staging -- prisma migrate deploy",
    "db:migrate:prod": "dotenv -e .env.production -- prisma migrate deploy",
    "db:seed:dev": "dotenv -e .env.development -- prisma db seed",
    "db:seed:staging": "dotenv -e .env.staging -- prisma db seed",
    "db:seed:prod": "dotenv -e .env.production -- prisma db seed",
    "db:migrate:data": "tsx scripts/migrate-data.ts",
    "db:transfer:prod": "tsx scripts/transfer-data.ts",
    "db:sync:catalog": "tsx scripts/sync-catalog.ts",
    "deploy:staging": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1 -Target staging",
    "deploy:prod": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1 -Target production"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
