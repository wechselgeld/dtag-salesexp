{"nodes": [{"id": "rbac_architecture_md", "label": "RBAC & RLS Architecture", "file_type": "document", "source_file": "docs/architecture/rbac-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_rls", "label": "Row-Level Security (RLS)", "file_type": "rationale", "source_file": "docs/architecture/rbac-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ensures data access boundaries are automatically and transparently enforced in PostgreSQL via static Prisma Client query extensions using logical AND condition injections to prevent search filters from bypassing security constraints."}, {"id": "concept_hierarchical_scope_engine", "label": "Hierarchical Scope Engine", "file_type": "rationale", "source_file": "docs/architecture/rbac-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents cross-scope resource mutation by mapping and validating user organizational lineage (OD Region, Location, Team) against requested resource paths in a custom tRPC middleware."}, {"id": "concept_session_revocation", "label": "Session Verification & Revocation", "file_type": "rationale", "source_file": "docs/architecture/rbac-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verifies JWT session validity by querying the DB on every request, but caches this verification in Dragonfly Redis for 60 seconds with instant cache invalidation upon any user updates to avoid DB roundtrips while keeping session management secure."}], "edges": [{"source": "rbac_architecture_md", "target": "concept_rls", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/rbac-architecture.md", "source_location": null, "weight