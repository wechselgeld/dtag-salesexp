generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  password   String
  role       String    @default("TEAM_LEADER")
  isEditor   Boolean   @default(false)
  odRegionId String?
  locationId String?
  teamId     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  location   Location? @relation(fields: [locationId], references: [id])
  odRegion   OdRegion? @relation(fields: [odRegionId], references: [id])
  team       Team?     @relation(fields: [teamId], references: [id])
}

model OdRegion {
  id        String     @id @default(cuid())
  name      String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  locations Location[]
  news      News[]
  users     User[]
}

model Location {
  id         String    @id @default(cuid())
  name       String
  address    String?
  isActive   Boolean   @default(true)
  odRegionId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  odRegion   OdRegion? @relation(fields: [odRegionId], references: [id])
  news       News[]
  teams      Team[]
  users      User[]
}

model Product {
  id                      String          @id @default(cuid())
  name                    String
  description             String?
  category                String
  basePrice               Float
  isActive                Boolean         @default(true)
  priority                Int             @default(0)
  dataVolume              String?
  downloadSpeed           Int?
  uploadSpeed             Int?
  contractDuration        Int?            @default(24)
  allowNewActivation      Boolean         @default(true)
  allowMove               Boolean         @default(true)
  allowPlanChange         Boolean         @default(true)
  allowSpeedUp            Boolean         @default(false)
  activationFeeNew        Float?
  activationFeeMove       Float?
  activationFeePlanChange Float?          @default(0)
  activationFeeSpeedUp    Float?
  allowMagentaTV          Boolean         @default(false)
  hasMagentaTVBundle      Boolean         @default(false)
  magentaTVBundleName     String?
  magentaTVBundlePrice    Float?
  allowHardwareTiers      Boolean         @default(false)
  deviceManufacturer      String?
  deviceContext           String?
  purchasePrice           Float?
  rentalPrice             Float?
  features                String?
  targetGroups            String?
  salesScript             String?
  magentaInfosUrl         String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  priceHistory            PriceHistory[]
  salesArguments          SalesArgument[]
  highlights              TeamHighlight[]
  compatibleAddons        Addon[]         @relation("ProductAddons")
  specialPrices           SpecialPrice[]  @relation("ProductSpecialPrices")
}

model SalesArgument {
  id        String   @id @default(cuid())
  text      String
  productId String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  price     Float
  label     String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SpecialPrice {
  id                    String             @id @default(cuid())
  name                  String
  description           String?
  internalNote          String?
  magentaTVRequirement  String             @default("NONE")
  requiresSpeedUp       Boolean            @default(false)
  requiresMove          Boolean            @default(false)
  requiresNewActivation Boolean            @default(false)
  discountTarget        String             @default("BASE_PRICE")
  discountType          String             @default("ABSOLUTE")
  isActive              Boolean            @default(true)
  priority              Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  tiers                 SpecialPriceTier[]
  products              Product[]          @relation("ProductSpecialPrices")
}

model SpecialPriceTier {
  id             String       @id @default(cuid())
  specialPriceId String
  price          Float
  fromMonth      Int
  toMonth        Int
  discountTarget String       @default("BASE_PRICE")
  discountType   String       @default("ABSOLUTE")
  specialPrice   SpecialPrice @relation(fields: [specialPriceId], references: [id], onDelete: Cascade)
}

model Addon {
  id                   String          @id @default(cuid())
  name                 String
  description          String?
  category             String?
  isGlobal             Boolean         @default(false)
  isActive             Boolean         @default(true)
  magentaTVRequirement String          @default("NONE")
  imageUrl             String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  tiers                AddonTier[]
  highlights           TeamHighlight[]
  compatibleProducts   Product[]       @relation("ProductAddons")
}

model AddonTier {
  id      String @id @default(cuid())
  addonId String
  name    String
  price   Float
  addon   Addon  @relation(fields: [addonId], references: [id], onDelete: Cascade)
}

model TeamHighlight {
  id           String   @id @default(cuid())
  teamId       String
  productId    String?
  addonId      String?
  category     String?
  businessCase String?
  reason       String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  addon        Addon?   @relation(fields: [addonId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model MaintenanceAnnouncement {
  id         String    @id @default(cuid())
  title      String
  message    String
  priority   String
  isActive   Boolean   @default(true)
  validFrom  DateTime?
  validUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model OneTimeCredit {
  id        String   @id @default(cuid())
  name      String
  value     Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id         String          @id @default(cuid())
  name       String
  email      String          @default("team06@telekom.de")
  locationId String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  news       News[]
  sessions   SalesSession[]
  location   Location?       @relation(fields: [locationId], references: [id])
  highlights TeamHighlight[]
  users      User[]

  @@index([locationId])
}

model SalesSession {
  id                    String    @id @default(cuid())
  teamId                String
  acceptedTerms         Boolean   @default(false)
  userAgent             String?
  ip                    String?
  deviceId              String?
  isActive              Boolean   @default(true)
  expiresAt             DateTime?
  email                 String?
  firstName             String?
  lastName              String?
  isVerified            Boolean   @default(false)
  verificationToken     String?   @unique
  verificationExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  team                  Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model News {
  id         String    @id @default(cuid())
  title      String
  content    String
  priority   String    @default("INFO")
  isActive   Boolean   @default(true)
  odRegionId String?
  locationId String?
  teamId     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  odRegion   OdRegion? @relation(fields: [odRegionId], references: [id], onDelete: Cascade)
  team       Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  key   String @id
  value String
}

model Passkey {
  id             String   @id // WebAuthn Credential ID
  email          String
  publicKey      Bytes
  counter        BigInt
  transports     String?
  createdAt      DateTime @default(now())
  lastUsedAt     DateTime @default(now())

  @@index([email])
}
