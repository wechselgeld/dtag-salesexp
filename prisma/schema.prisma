generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Models

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  password   String
  role       String    @default("TEAM_LEADER") // "ADMIN", "OD_MANAGER", "LOCATION_MANAGER", "TEAM_LEADER"
  isEditor   Boolean   @default(false)
  
  odRegionId String?
  odRegion   OdRegion? @relation(fields: [odRegionId], references: [id], onDelete: SetNull)
  
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  teamId     String?
  team       Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model OdRegion {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  
  locations Location[]
  users     User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Location {
  id         String   @id @default(cuid())
  name       String
  address    String?
  isActive   Boolean  @default(true)
  odRegionId String?
  odRegion   OdRegion? @relation(fields: [odRegionId], references: [id], onDelete: SetNull)

  teams     Team[]
  users     User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String  @id @default(cuid())
  name        String
  description String?
  category    String // "MOBILE", "FIBER", "DSL", "MAGENTA_TV_OTT", "DEVICE"
  basePrice   Float
  isActive    Boolean @default(true)
  priority    Int     @default(0)

  // Tariff Specifics
  dataVolume       String?
  downloadSpeed    Int?
  uploadSpeed      Int?
  contractDuration Int?    @default(24)

  // Business Case Rules
  allowNewActivation Boolean @default(true)
  allowMove          Boolean @default(true)
  allowPlanChange    Boolean @default(true)
  allowSpeedUp       Boolean @default(false)

  // Fees
  activationFeeNew        Float?
  activationFeeMove       Float?
  activationFeePlanChange Float? @default(0)
  activationFeeSpeedUp    Float?

  // MagentaTV Compatibility
  allowMagentaTV       Boolean @default(false)
  hasMagentaTVBundle   Boolean @default(false)
  magentaTVBundleName  String?
  magentaTVBundlePrice Float?

  // Device Specifics
  deviceManufacturer String?
  deviceContext      String?
  purchasePrice      Float?
  rentalPrice        Float?

  features     String? @db.Text // JSON string
  targetGroups String? @db.Text // JSON string array of target groups e.g. ["student", "family"]
  salesScript  String? @db.Text // Text for sales agents
  magentaInfosUrl String? // Link to internal information platform

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  specialPrices    SpecialPrice[]  @relation("ProductSpecialPrices")
  highlights       TeamHighlight[]
  compatibleAddons Addon[]         @relation("ProductAddons")
  salesArguments   SalesArgument[]
}

model SalesArgument {
  id        String  @id @default(cuid())
  text      String  @db.Text
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SpecialPrice {
  id           String    @id @default(cuid())
  name         String
  description  String?
  internalNote String?
  products Product[] @relation("ProductSpecialPrices")

  tiers SpecialPriceTier[]

  // Context Conditions
  requiresMagentaTV Boolean @default(false)
  requiresSpeedUp   Boolean @default(false)
  requiresMove      Boolean @default(false)

  discountTarget String @default("BASE_PRICE") // "BASE_PRICE", "MAGENTA_TV"
  discountType   String @default("ABSOLUTE")   // "ABSOLUTE", "RELATIVE"

  isActive Boolean @default(true)
  priority Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SpecialPriceTier {
  id             String       @id @default(cuid())
  specialPriceId String
  specialPrice   SpecialPrice @relation(fields: [specialPriceId], references: [id], onDelete: Cascade)

  price     Float
  fromMonth Int
  toMonth   Int
}

model Addon {
  id          String  @id @default(cuid())
  name        String
  description String?
  category    String?

  isGlobal Boolean @default(false)
  isActive Boolean @default(true)
  requiresNoMagentaTV Boolean @default(false)

  imageUrl String?

  tiers AddonTier[]

  compatibleProducts Product[]       @relation("ProductAddons")
  highlights         TeamHighlight[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AddonTier {
  id      String @id @default(cuid())
  addonId String
  addon   Addon  @relation(fields: [addonId], references: [id], onDelete: Cascade)

  name  String
  price Float
}

model TeamHighlight {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  addonId String?
  addon   Addon?  @relation(fields: [addonId], references: [id], onDelete: Cascade)

  category     String?
  businessCase String?

  reason String?
  active Boolean @default(true)

  createdAt DateTime @default(now())
}

model MaintenanceAnnouncement {
  id       String  @id @default(cuid())
  title    String
  message  String  @db.Text
  priority String // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  isActive Boolean @default(true)

  validFrom  DateTime?
  validUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OneTimeCredit {
  id       String  @id @default(cuid())
  name     String
  value    Float
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id         String   @id @default(cuid())
  name       String
  email      String   @default("team06@telekom.de")
  
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  
  users      User[]

  sessions   SalesSession[]
  highlights TeamHighlight[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalesSession {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  acceptedTerms Boolean @default(false)

  userAgent String?
  ip        String?

  isActive  Boolean   @default(true)
  expiresAt DateTime?

  // Nutzerinformationen / Verifizierung
  email             String?
  firstName         String?
  lastName          String?
  isVerified            Boolean @default(false)
  verificationToken     String? @unique
  verificationExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model News {
  id       String  @id @default(cuid())
  title    String
  content  String  @db.Text
  priority String  @default("INFO") // "INFO", "UPDATE", "IMPORTANT", "CRITICAL"
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model SystemSetting {
  key   String @id
  value String
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  eventType String   @db.VarChar(50)      // "PAGE_VIEW", "PRODUCT_VIEW", "BASKET_ADD"
  path      String?  @db.VarChar(255)
  productId String?  @db.VarChar(50)
  category  String?  @db.VarChar(50)
  teamId    String?  @db.VarChar(50)
  count     Int      @default(1)

  @@unique([date, eventType, path, productId, category, teamId], name: "analytics_unique_event")
  @@index([date])
  @@index([eventType])
  @@index([productId])
}
